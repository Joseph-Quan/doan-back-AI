# Server
PORT=3000
NODE_ENV=development

# Database (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=woodhome

# JWT
JWT_SECRET=woodhome_secret_key_2026_very_long_and_secure
JWT_EXPIRES_IN=7d

# Email (nodemailer - dùng SMTP Gmail hoặc bất kỳ SMTP nào)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
EMAIL_FROM=WoodHome <your_email@gmail.com>

# Upload
UPLOAD_DIR=src/uploads
MAX_FILE_SIZE=5242880

# Frontend URL
FRONTEND_URL=http://localhost:3000
