# Server
PORT=3000
NODE_ENV=production

# Database (MySQL) - Dùng PlanetScale hoặc Railway MySQL cho production
DB_HOST=your-db-host.mysql.database.azure.com
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=woodhome

# JWT - Thay bằng secret key dài và ngẫu nhiên
JWT_SECRET=your_very_long_and_random_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# Email (nodemailer - dùng SMTP Gmail hoặc bất kỳ SMTP nào)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
EMAIL_FROM=WoodHome <your_email@gmail.com>

# Upload
UPLOAD_DIR=src/uploads
MAX_FILE_SIZE=5242880

# Frontend URL
FRONTEND_URL=https://your-vercel-app.vercel.app
