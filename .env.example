# Server
PORT=3000
NODE_ENV=production

# Supabase
SUPABASE_URL=https://your-project-ref.supabase.co
# Chỉ dùng ở backend/serverless, không đưa key này vào frontend.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
# Frontend Vite variables
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key

# JWT - Thay bằng secret key dài và ngẫu nhiên
JWT_SECRET=your_very_long_and_random_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# Email (nodemailer - dùng SMTP Gmail hoặc bất kỳ SMTP nào)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
EMAIL_FROM=WoodHome <your_email@gmail.com>

# Upload
UPLOAD_DIR=src/uploads
MAX_FILE_SIZE=5242880

# Frontend URL
FRONTEND_URL=https://your-vercel-app.vercel.app

# Chỉ bật cho môi trường demo nội bộ; production phải dùng cổng thanh toán thật.
PAYMENT_DEMO_MODE=false
